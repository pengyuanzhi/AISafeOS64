#
# AISafe64 Default Configuration
# AI-Generated, Safety-Certifiable, Native 64-bit RTOS
#

# Core Configuration
CONFIG_NR_CPUS=4
CONFIG_PRIORITY_256=y
CONFIG_PRIORITY_LEVELS=256
CONFIG_MAX_TASKS=32
CONFIG_TICK_RATE_HZ=1000

# Memory Configuration
CONFIG_KERNEL_HEAP_SIZE=0x100000
CONFIG_TASK_STACK_SIZE=8192
CONFIG_ENABLE_MMU=y
CONFIG_MMU_PAGE_SIZE=4096

# SMP Configuration
CONFIG_ENABLE_SMP=y
CONFIG_IPI_SUPPORT=y
CONFIG_LOAD_BALANCE=y
CONFIG_LOAD_BALANCE_THRESHOLD=30

# Safety Configuration
CONFIG_STACK_CHECK=y
CONFIG_CODE_PROTECT=y
CONFIG_CODE_INTEGRITY=y
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_TIMEOUT=1000

# Debug Configuration
# CONFIG_DEBUG is not set
CONFIG_LOG_WARN=y
CONFIG_LOG_LEVEL=2
CONFIG_ASSERT_LEVEL=2
# CONFIG_PERF_COUNTERS is not set

# Core Dump and Debug Support
# CONFIG_CORE_DUMP is not set
CONFIG_STACK_BACKTRACE=y
CONFIG_BACKTRACE_MAX_FRAMES=32

# Performance Monitoring
CONFIG_PERF_MONITOR=y
CONFIG_PERF_TASK_STATS=y
CONFIG_PERF_WCET=y
CONFIG_PERF_DEADLINE=y
# CONFIG_PERF_PMU is not set

# Device Driver Model
CONFIG_DEVICE_MODEL=y
CONFIG_DEVICE_CHAR=y
CONFIG_DEVICE_BLOCK=y
# CONFIG_DEVICE_NET is not set
CONFIG_DEVICE_PLATFORM=y
# CONFIG_DEVICE_HOTPLUG is not set
CONFIG_DEVICE_POWER_MGMT=y

# POSIX Compatibility Layer
CONFIG_POSIX_COMPAT=y
CONFIG_POSIX_PTHREAD=y
CONFIG_POSIX_MUTEX=y
CONFIG_POSIX_SEMAPHORE=y
CONFIG_POSIX_COND=y
CONFIG_POSIX_RWLOCK=y
CONFIG_POSIX_SLEEP=y
CONFIG_POSIX_SCHED=y
CONFIG_POSIX_SIGNAL=y
CONFIG_POSIX_TIME=y
CONFIG_POSIX_BARRIER=y
CONFIG_POSIX_SPINLOCK=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_FILELOCK=y
CONFIG_POSIX_KEY=y
CONFIG_POSIX_CANCEL=y
CONFIG_POSIX_ONCE=y
CONFIG_POSIX_SHM=y
CONFIG_POSIX_TIMER=y
CONFIG_POSIX_AIO=y

# Device Tree Support
CONFIG_DEVICE_TREE=y
CONFIG_DT_BLOB_ADDR=0x0
CONFIG_DT_EARLY_BINDINGS=y
# CONFIG_DT_DYNAMIC is not set

# Hardware Configuration
CONFIG_BOARD_RPI4=y
CONFIG_BOARD_NAME="rpi4"
CONFIG_GIC_V3=y
CONFIG_GIC_VERSION=3
CONFIG_ARCH_TIMER=y
