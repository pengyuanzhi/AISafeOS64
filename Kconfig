menu "Device Tree Support"

config DEVICE_TREE
    bool "Flattened Device Tree (FDT) Support"
    default y
    help
      Enable device tree support for hardware description. Uses
      flattened device tree (DTB) format compatible with Linux.

config DT_BLOB_ADDR
    hex "Device Tree Blob Address"
    depends on DEVICE_TREE
    default 0x0
    help
      Physical address of the device tree blob in memory.

config DT_EARLY_BINDINGS
    bool "Early Device Tree Bindings"
    depends on DEVICE_TREE
    default y
    help
      Parse device tree early during boot for essential hardware.

config DT_DYNAMIC
    bool "Dynamic Device Tree Modification"
    depends on DEVICE_TREE
    default n
    help
      Allow runtime modifications to device tree (advanced).

endmenu
