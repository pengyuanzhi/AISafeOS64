{
  "permissions": {
    "allow": [
      "Bash(wc:*)",
      "Bash(tree:*)",
      "Bash(./scripts/git_push.sh:*)",
      "Bash(dir:*)",
      "Bash(find:*)",
      "Bash(for:*)",
      "Bash(do if [ -f \"$f\" ])",
      "Bash(fi:*)",
      "Bash(python:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(./scripts/smart_commit.sh:*)",
      "Bash(bash scripts/smart_commit.sh:*)",
      "Bash(ls:*)",
      "Bash(done:*)",
      "Bash(echo \"archive exists: $?\")",
      "Bash(echo \"logs exists: $?\")",
      "Bash(git checkout:*)",
      "Bash(git status:*)",
      "Bash(git config:*)",
      "Bash(git:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/session_start.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/user_prompt_submit.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/stop.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/session_end.py"
          }
        ]
      }
    ]
  }
}
