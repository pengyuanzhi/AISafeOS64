#!/bin/bash
#
# AISafe64 RTOS - Git pre-commit hook
# 自动运行 clang-format 格式化暂存的 C/C++ 源文件
#

# 颜色输出
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# 检查 clang-format 是否可用
if ! command -v clang-format &> /dev/null; then
    echo -e "${YELLOW}Warning: clang-format not found in PATH. Skipping auto-formatting.${NC}"
    echo -e "${YELLOW}Please install clang-format and add it to your PATH.${NC}"
    echo -e "${YELLOW}Download: https://llvm.org/${NC}"
    exit 0
fi

# 获取暂存的 C/C++ 文件
# 包括新增和修改的文件
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(c|cpp|h|hpp|cc|cxx)$')

if [ -z "$STAGED_FILES" ]; then
    # 没有C/C++文件需要格式化
    exit 0
fi

# 格式化文件并重新添加到暂存区
echo -e "${GREEN}Running clang-format on staged files...${NC}"

FORMAT_FAILED=0
for FILE in $STAGED_FILES; do
    if [ -f "$FILE" ]; then
        # 格式化文件并检查是否有变化
        clang-format -i -style=file "$FILE" 2>/dev/null

        if [ $? -ne 0 ]; then
            echo -e "${RED}Error: Failed to format $FILE${NC}"
            FORMAT_FAILED=1
        else
            echo -e "${GREEN}Formatted: $FILE${NC}"
            # 重新添加格式化后的文件到暂存区
            git add "$FILE"
        fi
    fi
done

if [ $FORMAT_FAILED -eq 1 ]; then
    echo -e "${RED}Some files failed to format. Commit aborted.${NC}"
    exit 1
fi

echo -e "${GREEN}clang-format completed successfully.${NC}"
exit 0
